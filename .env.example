==========================================
# Incident - Environment Configuration
# ==========================================

# Application
SERVER_PORT=8080

# MySQL
MYSQL_DATABASE=incident
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

DB_URL=jdbc:mysql://mysql:3306/incident
DB_USERNAME=incident_user
DB_PASSWORD=replace_with_local_database_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# JWT Security
# Replace with a securely generated random secret.
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
JWT_EXPIRATION=86400000

# Frontend CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenAI
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.6